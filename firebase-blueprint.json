{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and personalized academic learning profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "educationLevel": { "type": "string", "maxLength": 60 },
        "courseDegree": { "type": "string", "maxLength": 100 },
        "currentSemester": { "type": "string", "maxLength": 50 },
        "preferredLearningStyle": { "type": "string", "enum": ["Visual", "Auditory", "Reading/Writing", "Kinesthetic"] },
        "dailyStudyAvailability": { "type": "number" },
        "learningGoals": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Adaptive study plan entity with timeline and goal objectives",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "currentSkillLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "availableHoursPerDay": { "type": "number" },
        "targetCompletionDate": { "type": "string", "maxLength": 50 },
        "learningGoal": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "currentSkillLevel", "status", "createdAt"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Individual micro-learning study task belonging to a student plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "planId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "timeSlot": { "type": "string", "maxLength": 50 },
        "estimatedDuration": { "type": "number" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "learningObjective": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Completed"] },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "planId", "userId", "subject", "topic", "status"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Assessment attempt score and performance record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 150 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "subject", "topic", "score", "totalQuestions", "completedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User account profile and academic configuration"
    },
    "/users/{userId}/plans/{planId}": {
      "schema": "#/entities/StudyPlan",
      "description": "Personalized study plans created by or for the user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "#/entities/StudyTask",
      "description": "Study tasks assigned to the user"
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": "#/entities/QuizAttempt",
      "description": "Quiz test history and results"
    }
  }
}
